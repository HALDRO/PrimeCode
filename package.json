{
	"name": "primecode",
	"displayName": "PrimeCode",
	"description": "OpenCode-first AI coding assistant for VS Code",
	"version": "1.5.7",
	"main": "./dist/extension.js",
	"scripts": {
		"vscode:prepublish": "bun run build",
		"build": "bun run build:extension && bun run build:webview",
		"build:extension": "node esbuild.config.mjs --production",
		"build:webview": "vite build --config vite.config.webview.ts",
		"watch": "concurrently \"bun run watch:extension\" \"bun run watch:webview\"",
		"watch:extension": "node esbuild.config.mjs --watch",
		"watch:webview": "vite build --config vite.config.webview.ts --watch",
		"dev": "vite",
		"pack": "npx @vscode/vsce package",
		"release": "npx @vscode/vsce publish",
		"lint:tsc": "tsc --noEmit --pretty false -p ./tsconfig.extension.json && tsc --noEmit --pretty false -p ./src/webview/tsconfig.json",
		"lint:biome": "biome check --max-diagnostics=500 src/",
		"lint": "bun run lint:fix && bun run lint:tsc",
		"lint:fix": "biome check --write --unsafe src/",
		"format": "biome format --write src/",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:vscode": "npx @vscode/test-cli",
		"dead-code": "knip --include exports,types,duplicates"
	},
	"knip": {
		"entry": [
			"src/extension.ts",
			"src/common/index.ts",
			"src/webview/store/index.ts",
			"src/webview/components/ui/index.ts",
			"src/webview/components/icons/index.tsx",
			"src/webview/constants.ts",
			"src/**/*.test.ts",
			"tests/**/*.ts"
		],
		"project": [
			"src/**/*.{ts,tsx}",
			"tests/**/*.ts"
		],
		"ignore": [
			"docs/**",
			"dist/**"
		]
	},
	"dependencies": {
		"@cfworker/json-schema": "^4.1.1",
		"@codemirror/commands": "^6.10.3",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.0",
		"@floating-ui/react": "^0.27.19",
		"@microsoft/fetch-event-source": "^2.0.1",
		"@modelcontextprotocol/client": "^2.0.0-alpha.2",
		"@opencode-ai/sdk": "1.15.7",
		"@sinclair/typebox": "^0.34.49",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"framer-motion": "^12.40.0",
		"immer": "^11.1.8",
		"js-yaml": "^4.1.1",
		"lucide-react": "^1.16.0",
		"openai": "^6.38.0",
		"overlayscrollbars": "^2.16.0",
		"overlayscrollbars-react": "^0.5.6",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-markdown": "^10.1.0",
		"react-virtuoso": "^4.18.7",
		"rehype-highlight": "^7.0.2",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.6.0",
		"vscode-icons-js": "^11.6.1",
		"zustand": "^5.0.13"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@biomejs/biome": "2.4.15",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tailwindcss/vite": "^4.3.0",
		"@types/babel__core": "^7.20.5",
		"@types/cross-spawn": "^6.0.6",
		"@types/js-yaml": "^4.0.9",
		"@types/mocha": "^10.0.10",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"@types/vscode": "^1.120.0",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/coverage-v8": "^4.1.7",
		"@vscode/test-electron": "^2.5.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"concurrently": "^9.2.1",
		"esbuild": "^0.28.0",
		"knip": "^6.14.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.14",
		"vitest": "^4.1.7"
	},
	"trustedDependencies": [
		"@biomejs/biome"
	],
	"publisher": "HALDRO",
	"author": "HALDRO",
	"repository": {
		"type": "git",
		"url": "https://github.com/HALDRO/PrimeCode"
	},
	"license": "Apache-2.0",
	"engines": {
		"vscode": "^1.120.0"
	},
	"categories": [
		"AI",
		"Chat",
		"Machine Learning"
	],
	"keywords": [
		"primecode",
		"opencode",
		"code explanation",
		"code generation",
		"code summary",
		"code transform",
		"vibe coding",
		"prompt language",
		"copilot",
		"ai",
		"assistant",
		"chatbot",
		"chat",
		"code",
		"programming",
		"development",
		"productivity"
	],
	"icon": "public/icon.png",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"commands": [
			{
				"command": "primecode.openChat",
				"title": "Open PrimeCode",
				"category": "PrimeCode",
				"icon": "public/icon.png"
			},
			{
				"command": "primecode.newChat",
				"title": "New Chat",
				"category": "PrimeCode",
				"icon": "$(add)"
			},
			{
				"command": "primecode.showHistory",
				"title": "History",
				"category": "PrimeCode",
				"icon": "$(history)"
			},
			{
				"command": "primecode.openSettings",
				"title": "Settings",
				"category": "PrimeCode",
				"icon": "$(settings-gear)"
			},
			{
				"command": "primecode.addSelectionToPrompt",
				"title": "Add Selection to Chat",
				"category": "PrimeCode",
				"icon": "$(add)"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "primecode.openChat"
				},
				{
					"command": "primecode.newChat"
				},
				{
					"command": "primecode.showHistory"
				},
				{
					"command": "primecode.openSettings"
				},
				{
					"command": "primecode.addSelectionToPrompt"
				}
			],
			"editor/context": [
				{
					"command": "primecode.openChat",
					"group": "primecode@1",
					"when": "editorTextFocus"
				},
				{
					"command": "primecode.addSelectionToPrompt",
					"group": "primecode@2",
					"when": "editorHasSelection"
				}
			],
			"editor/title": [
				{
					"command": "primecode.openChat",
					"group": "navigation@1",
					"when": "true"
				}
			],
			"editor/title/context": [
				{
					"command": "primecode.openChat",
					"group": "primecode@1"
				}
			],
			"explorer/context": [
				{
					"command": "primecode.openChat",
					"group": "primecode@1"
				}
			],
			"scm/title": [
				{
					"command": "primecode.openChat",
					"group": "navigation@1",
					"when": "true"
				}
			],
			"view/title": [
				{
					"command": "primecode.openChat",
					"group": "navigation@1",
					"when": "view == workbench.explorer.fileView"
				},
				{
					"command": "primecode.newChat",
					"group": "navigation@2",
					"when": "view == primecode.chat"
				},
				{
					"command": "primecode.showHistory",
					"group": "navigation@3",
					"when": "view == primecode.chat"
				},
				{
					"command": "primecode.openSettings",
					"group": "navigation@4",
					"when": "view == primecode.chat"
				}
			],
			"touchBar": [
				{
					"command": "primecode.openChat",
					"group": "editing",
					"when": "true"
				}
			],
			"menuBar/file": [
				{
					"command": "primecode.openChat",
					"group": "1_new@1"
				}
			]
		},
		"views": {
			"primecode": [
				{
					"id": "primecode.chat",
					"type": "webview",
					"name": "PrimeCode",
					"when": "true",
					"icon": "public/icon.png",
					"contextualTitle": "PrimeCode"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "primecode",
					"title": "PrimeCode",
					"icon": "public/icon.png"
				}
			]
		},
		"configuration": {
			"title": "PrimeCode",
			"properties": {
				"primeCode.opencode.autoStart": {
					"type": "boolean",
					"default": true,
					"description": "Automatically start OpenCode server when the extension activates"
				},
				"primeCode.opencode.serverTimeout": {
					"type": "number",
					"default": 15000,
					"description": "Timeout in milliseconds for OpenCode server to start"
				},
				"primeCode.opencode.serverUrl": {
					"type": "string",
					"default": "",
					"description": "URL of an existing OpenCode server to connect to (e.g. http://127.0.0.1:3000). If set, the extension will not start a new server."
				},
				"primeCode.access.autoApprove": {
					"type": "boolean",
					"default": false,
					"description": "Automatically approve all file edit and creation requests without showing permission dialogs."
				}
			}
		}
	}
}
